# Database connection (PostgreSQL 17)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_pme_finance?schema=public"

# API configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1

# Security & Authentication
JWT_SECRET=smart_pme_finance_super_secure_jwt_secret_key_prod_2026_xyz
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=smart_pme_finance_refresh_jwt_key_2026_abc
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Application URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# Regional / Default Currency Settings (RDC)
DEFAULT_CURRENCY=CDF
SECONDARY_CURRENCY=USD
DEFAULT_EXCHANGE_RATE_USD_TO_CDF=2850.00
